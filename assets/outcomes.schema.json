{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Co-Scientist External Outcomes",
  "type": "object",
  "required": ["outcomes"],
  "properties": {
    "schema_version": {"type": "integer"},
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "status"],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "status": {
            "enum": ["supported", "refuted", "inconclusive", "unknown"]
          },
          "source": {"type": "string"},
          "metric": {"type": "string"},
          "value": {},
          "note": {"type": "string"}
        }
      }
    }
  }
}
