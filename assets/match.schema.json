{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Co-Scientist Match",
  "type": "object",
  "required": ["a", "b", "winner"],
  "properties": {
    "id": {"type": "string"},
    "a": {"type": "string"},
    "b": {"type": "string"},
    "winner": {"type": "string", "description": "a, b, or draw"},
    "depth": {"enum": ["multi", "single"], "description": "multi = three-round debate; single = one opening round"},
    "reason": {"type": "string", "description": "why this match was scheduled"},
    "order_presented": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 2,
      "maxItems": 2
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decisive_criterion": {"type": "string"},
    "rationale": {"type": "string"},
    "scores": {"type": "object"},
    "judge": {"type": "string"},
    "steelman": {"type": "object"},
    "strongest_counterargument_to_winner": {"type": "string"},
    "what_would_flip_the_decision": {"type": "string"},
    "new_facts_introduced": {"type": "boolean"}
  }
}
